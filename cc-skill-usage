#!/usr/bin/env python3
"""cc-skill-usage - retroactive Claude Code Skill usage analytics.

Reads the JSONL transcripts under ~/.claude/projects/ and reports how often
each Skill was actually invoked, when, and in which project. It counts real
invocations only: a tool_use block whose name == "Skill". A skill merely
mentioned in prose is not an invocation and is never counted.

Single file, Python 3 standard library only. No external dependencies.
"""

import argparse
import json
import os
import sys
import time
from collections import Counter, defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path

VERSION = "0.2.1"

PROJECTS_DIR = Path(
    os.environ.get("CC_PROJECTS_DIR", Path.home() / ".claude" / "projects")
)
CACHE_DIR = Path(
    os.environ.get(
        "CC_SKILL_USAGE_CACHE",
        Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
        / "cc-skill-usage",
    )
)
CACHE_FILE = CACHE_DIR / "index.json"
CACHE_SCHEMA = 2


# --------------------------------------------------------------------------
# Parsing
# --------------------------------------------------------------------------

def project_from_record(record, jsonl_path):
    """Best project label: basename of the record cwd, else the encoded dir."""
    cwd = record.get("cwd")
    if cwd:
        base = os.path.basename(cwd.rstrip("/"))
        if base:
            return base
    # Fallback: the first directory segment under projects/ is the encoded cwd.
    try:
        rel = jsonl_path.relative_to(PROJECTS_DIR)
        return rel.parts[0]
    except ValueError:
        return jsonl_path.parent.name


def repo_hint_from_path(jsonl_path):
    """Encoded top-level project dir. Stable across worktrees of the same repo
    (e.g. every '.../MethodeAristote-app--worktrees-<branch>' session shares the
    'MethodeAristote-app' substring), unlike the cwd basename which is the
    worktree's branch-named leaf directory."""
    try:
        rel = jsonl_path.relative_to(PROJECTS_DIR)
        return rel.parts[0]
    except ValueError:
        return jsonl_path.parent.name


def is_subagent(jsonl_path):
    return "subagents" in jsonl_path.parts


def extract_text(message):
    """Best-effort plain text from a user/assistant message, for context display."""
    if not isinstance(message, dict):
        return None
    content = message.get("content")
    if isinstance(content, str):
        text = content
    elif isinstance(content, list):
        parts = [
            b.get("text", "") for b in content
            if isinstance(b, dict) and b.get("type") == "text"
        ]
        text = " ".join(p for p in parts if p)
    else:
        return None
    text = " ".join(text.split())
    return text[:200] if text else None


def parse_file(jsonl_path):
    """Yield one event dict per real Skill invocation found in a transcript."""
    subagent = is_subagent(jsonl_path)
    repo_hint = repo_hint_from_path(jsonl_path)
    last_user_text = None
    try:
        with jsonl_path.open("r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                has_skill = False
                is_user_line = '"type":"user"' in line or '"type": "user"' in line
                if is_user_line:
                    # A Skill tool_use only ever appears in an assistant record,
                    # never a user one, so has_skill is irrelevant here even if
                    # the line happens to contain that substring (e.g. a tool
                    # result dumping a file that quotes a Skill JSON example).
                    # Tool results are stored as role "user" too and can be
                    # megabytes long (a full file read, a command output), so
                    # skip json.loads on them outright instead of paying to
                    # deserialize a huge blob just to look for a short prompt.
                    if '"tool_result"' in line or len(line) > 20000:
                        continue
                else:
                    has_skill = '"name":"Skill"' in line or '"name": "Skill"' in line
                    if not has_skill:
                        continue
                try:
                    record = json.loads(line)
                except (ValueError, json.JSONDecodeError):
                    continue

                if record.get("type") == "user":
                    text = extract_text(record.get("message"))
                    if text:
                        last_user_text = text
                    continue

                if not has_skill:
                    continue
                message = record.get("message")
                if not isinstance(message, dict):
                    continue
                content = message.get("content")
                if not isinstance(content, list):
                    continue
                for block in content:
                    if not isinstance(block, dict):
                        continue
                    if block.get("type") != "tool_use" or block.get("name") != "Skill":
                        continue
                    inp = block.get("input") or {}
                    skill = inp.get("skill")
                    if not skill:
                        continue
                    yield {
                        "skill": skill,
                        "args": inp.get("args"),
                        "ts": record.get("timestamp"),
                        "project": project_from_record(record, jsonl_path),
                        "repo_hint": repo_hint,
                        "session": jsonl_path.stem,
                        "subagent": subagent,
                        "context": last_user_text,
                    }
    except (OSError, IOError):
        return


# --------------------------------------------------------------------------
# Cache (mtime-invalidated)
# --------------------------------------------------------------------------

def load_cache():
    if not CACHE_FILE.exists():
        return {}
    try:
        with CACHE_FILE.open("r", encoding="utf-8") as fh:
            data = json.load(fh)
        if data.get("schema") != CACHE_SCHEMA:
            return {}
        return data.get("files", {})
    except (OSError, ValueError, json.JSONDecodeError):
        return {}


def save_cache(files):
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        tmp = CACHE_FILE.with_suffix(".tmp")
        with tmp.open("w", encoding="utf-8") as fh:
            json.dump({"schema": CACHE_SCHEMA, "files": files}, fh)
        tmp.replace(CACHE_FILE)
    except OSError:
        pass


def collect_events(no_cache=False, rebuild=False):
    """Scan all transcripts, using the mtime cache to skip unchanged files."""
    if not PROJECTS_DIR.exists():
        sys.stderr.write(f"No transcripts directory at {PROJECTS_DIR}\n")
        return []

    cache = {} if (no_cache or rebuild) else load_cache()
    new_cache = {}
    events = []

    for path in PROJECTS_DIR.rglob("*.jsonl"):
        key = str(path)
        try:
            mtime = path.stat().st_mtime
        except OSError:
            continue
        entry = cache.get(key)
        if entry and entry.get("mtime") == mtime:
            file_events = entry["events"]
        else:
            file_events = list(parse_file(path))
        new_cache[key] = {"mtime": mtime, "events": file_events}
        events.extend(file_events)

    if not no_cache:
        save_cache(new_cache)
    return events


# --------------------------------------------------------------------------
# Filtering & helpers
# --------------------------------------------------------------------------

def parse_ts(ts):
    if not ts:
        return None
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except ValueError:
        return None


def parse_since(since):
    """Accept 7d / 24h / 2w or an ISO date YYYY-MM-DD. Returns aware datetime."""
    now = datetime.now(timezone.utc)
    s = since.strip().lower()
    units = {"h": "hours", "d": "days", "w": "weeks"}
    if s and s[-1] in units and s[:-1].isdigit():
        return now - timedelta(**{units[s[-1]]: int(s[:-1])})
    try:
        d = datetime.fromisoformat(s)
        if d.tzinfo is None:
            d = d.replace(tzinfo=timezone.utc)
        return d
    except ValueError:
        sys.stderr.write(f"Bad --since value: {since} (use 7d, 24h, 2w or a date)\n")
        sys.exit(2)


def apply_filters(events, args):
    out = events
    if not args.include_subagents:
        out = [e for e in out if not e["subagent"]]
    if args.project:
        needle = args.project.lower()
        out = [
            e for e in out
            if needle in e["project"].lower() or needle in e["repo_hint"].lower()
        ]
    if args.since:
        floor = parse_since(args.since)
        kept = []
        for e in out:
            dt = parse_ts(e["ts"])
            if dt is not None and dt >= floor:
                kept.append(e)
        out = kept
    return out


def fmt_day(ts):
    dt = parse_ts(ts)
    return dt.date().isoformat() if dt else "unknown"


# --------------------------------------------------------------------------
# Views
# --------------------------------------------------------------------------

def view_leaderboard(events, as_json, show_context=False):
    counts = Counter(e["skill"] for e in events)
    projects = defaultdict(set)
    first = {}
    last = {}
    most_recent = {}  # skill -> (dt, event), for the last-context column

    for e in events:
        projects[e["skill"]].add(e["project"])
        day = fmt_day(e["ts"])
        if day != "unknown":
            if e["skill"] not in first or day < first[e["skill"]]:
                first[e["skill"]] = day
            if e["skill"] not in last or day > last[e["skill"]]:
                last[e["skill"]] = day
        dt = parse_ts(e["ts"])
        if dt is not None:
            prev = most_recent.get(e["skill"])
            if prev is None or dt > prev[0]:
                most_recent[e["skill"]] = (dt, e)

    rows = []
    for skill, n in counts.most_common():
        row = {
            "skill": skill,
            "invocations": n,
            "projects": len(projects[skill]),
            "first_seen": first.get(skill, "unknown"),
            "last_seen": last.get(skill, "unknown"),
        }
        if show_context:
            recent = most_recent.get(skill)
            if recent:
                _, e = recent
                row["last_context"] = e["context"]
                row["last_context_project"] = e["project"]
                row["last_context_session"] = e["session"]
            else:
                row["last_context"] = None
                row["last_context_project"] = None
                row["last_context_session"] = None
        rows.append(row)

    if as_json:
        print(json.dumps({
            "total_invocations": sum(counts.values()),
            "distinct_skills": len(counts),
            "skills": rows,
        }, indent=2))
        return

    if not rows:
        print("No skill invocations found.")
        return

    wname = max(len("SKILL"), max(len(r["skill"]) for r in rows))

    if not show_context:
        print(f"{'SKILL':<{wname}}  {'INVOC':>5}  {'PROJ':>4}  {'FIRST':>10}  {'LAST':>10}")
        print(f"{'-' * wname}  {'-'*5}  {'-'*4}  {'-'*10}  {'-'*10}")
        for r in rows:
            print(f"{r['skill']:<{wname}}  {r['invocations']:>5}  {r['projects']:>4}  "
                  f"{r['first_seen']:>10}  {r['last_seen']:>10}")
    else:
        print(f"{'SKILL':<{wname}}  {'INVOC':>5}  {'PROJ':>4}  {'LAST':>10}  "
              f"{'PROJECT':<20}  LAST CONTEXT")
        print(f"{'-' * wname}  {'-'*5}  {'-'*4}  {'-'*10}  {'-'*20}  {'-'*40}")
        for r in rows:
            ctx = r["last_context"] or "(no preceding user message found)"
            if len(ctx) > 70:
                ctx = ctx[:67] + "..."
            proj = (r["last_context_project"] or "")[:20]
            print(f"{r['skill']:<{wname}}  {r['invocations']:>5}  {r['projects']:>4}  "
                  f"{r['last_seen']:>10}  {proj:<20}  {ctx}")

    print(f"\n{sum(counts.values())} invocations across {len(counts)} skills.")


def view_detail(events, skill, as_json, show_context=False):
    hits = [e for e in events if e["skill"] == skill]
    by_project = Counter(e["project"] for e in hits)
    by_day = Counter(fmt_day(e["ts"]) for e in hits)
    by_args = Counter(e["args"] for e in hits if e["args"])
    sessions = {e["session"] for e in hits}

    if as_json:
        print(json.dumps({
            "skill": skill,
            "invocations": len(hits),
            "sessions": len(sessions),
            "by_project": dict(by_project.most_common()),
            "by_day": dict(sorted(by_day.items())),
            "by_args": dict(by_args.most_common()),
            "recent": [
                {
                    "ts": e["ts"], "project": e["project"], "session": e["session"],
                    "args": e["args"], "context": e["context"],
                }
                for e in sorted(
                    (e for e in hits if parse_ts(e["ts"]) is not None),
                    key=lambda e: parse_ts(e["ts"]), reverse=True,
                )[:20]
            ],
        }, indent=2))
        return

    if not hits:
        print(f"No invocations of '{skill}'.")
        return

    print(f"{skill}: {len(hits)} invocations across {len(sessions)} sessions\n")
    print("By project:")
    for proj, n in by_project.most_common():
        print(f"  {n:>4}  {proj}")
    if by_args:
        print("\nBy argument:")
        for a, n in by_args.most_common():
            print(f"  {n:>4}  {a}")
    print("\nBy day:")
    for day, n in sorted(by_day.items()):
        bar = "#" * min(n, 40)
        print(f"  {day}  {n:>3}  {bar}")

    if show_context:
        dated = sorted(
            (e for e in hits if parse_ts(e["ts"]) is not None),
            key=lambda e: parse_ts(e["ts"]), reverse=True,
        )
        print(f"\nRecent invocations (context = last user message before the call):")
        for e in dated[:10]:
            dt = parse_ts(e["ts"])
            when = dt.strftime("%Y-%m-%d %H:%M")
            sid = e["session"][:8]
            ctx = e["context"] or "(no preceding user message found)"
            print(f"  {when}  {e['project']}  session {sid}")
            print(f"    -> {ctx}")


def view_recent(events, limit, as_json, show_context=False):
    dated = [(parse_ts(e["ts"]), e) for e in events]
    dated = [(dt, e) for dt, e in dated if dt is not None]
    dated.sort(key=lambda x: x[0], reverse=True)
    picked = [e for _, e in dated[:limit]]

    if as_json:
        print(json.dumps([{
            "ts": e["ts"], "skill": e["skill"], "args": e["args"],
            "project": e["project"], "session": e["session"],
            "subagent": e["subagent"], "context": e["context"],
        } for e in picked], indent=2))
        return

    if not picked:
        print("No invocations found.")
        return

    wname = max(len(e["skill"]) for e in picked)
    for e in picked:
        dt = parse_ts(e["ts"])
        when = dt.strftime("%Y-%m-%d %H:%M") if dt else "unknown"
        tag = " (subagent)" if e["subagent"] else ""
        arg = f" [{e['args']}]" if e["args"] else ""
        sid = e["session"][:8]
        print(f"{when}  {e['skill']:<{wname}}{arg}  {e['project']}{tag}  session {sid}")
        if show_context:
            ctx = e["context"] or "(no preceding user message found)"
            print(f"  -> {ctx}")


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(
        prog="cc-skill-usage",
        description="Retroactive Claude Code Skill usage analytics "
                    "(reads ~/.claude/projects transcripts).",
    )
    p.add_argument("skill", nargs="?", help="show detail for one skill")
    p.add_argument("--all", nargs=2, metavar=("MODE", "N"),
                   help="e.g. --all recent 20 : list the N most recent invocations")
    p.add_argument("--since", metavar="WINDOW",
                   help="time filter: 7d, 24h, 2w, or a date YYYY-MM-DD")
    p.add_argument("--project", metavar="NAME",
                   help="filter by project: substring match on the cwd basename "
                        "OR the encoded project directory, so one repo's worktrees "
                        "(different branch-named cwd) match a single needle, e.g. "
                        "--project aristote")
    p.add_argument("--include-subagents", action="store_true",
                   help="also count invocations made inside subagents")
    p.add_argument("--show-context", action="store_true",
                   help="show the user message that preceded each invocation: "
                        "an extra column on the leaderboard (most recent per "
                        "skill), a full recent-invocations section in detail "
                        "view, and inline in --all recent")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.add_argument("--no-cache", action="store_true",
                   help="parse everything fresh, ignore and do not write the cache")
    p.add_argument("--rebuild", action="store_true",
                   help="ignore the cache on read but rewrite it")
    p.add_argument("--version", action="version", version=f"cc-skill-usage {VERSION}")
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)

    t0 = time.time()
    events = collect_events(no_cache=args.no_cache, rebuild=args.rebuild)
    events = apply_filters(events, args)
    elapsed = time.time() - t0

    if args.all:
        mode, n = args.all
        if mode != "recent":
            sys.stderr.write("Only '--all recent N' is supported.\n")
            return 2
        try:
            limit = int(n)
        except ValueError:
            sys.stderr.write(f"N must be an integer, got {n!r}.\n")
            return 2
        view_recent(events, limit, args.json, show_context=args.show_context)
    elif args.skill:
        view_detail(events, args.skill, args.json, show_context=args.show_context)
    else:
        view_leaderboard(events, args.json, show_context=args.show_context)

    if not args.json and os.environ.get("CC_SKILL_USAGE_TIMING"):
        sys.stderr.write(f"\nscanned in {elapsed:.2f}s\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
