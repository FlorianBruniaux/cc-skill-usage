#!/usr/bin/env python3
"""cc-skill-usage - cross-client Skill usage analytics.

Reads Claude Code transcripts, Codex instrumented events, and optional Codex
observed loads. Exact and inferred evidence are never merged silently.

Single file, Python 3 standard library only. No external dependencies.
"""

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
from collections import Counter, defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path
from urllib.parse import unquote, urlparse

VERSION = "0.3.0"

PROJECTS_DIR = Path(
    os.environ.get("CC_PROJECTS_DIR", Path.home() / ".claude" / "projects")
)
CACHE_DIR = Path(
    os.environ.get(
        "CC_SKILL_USAGE_CACHE",
        Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
        / "cc-skill-usage",
    )
)
CACHE_FILE = CACHE_DIR / "index.json"
CACHE_SCHEMA = 3
CODEX_SESSIONS_DIR = Path(
    os.environ.get("CODEX_SESSIONS_DIR", Path.home() / ".codex" / "sessions")
)
EVENT_LOG = Path(
    os.environ.get(
        "CC_SKILL_USAGE_EVENT_LOG",
        Path.home() / ".local" / "state" / "ai-agents" / "skill-usage" / "events.jsonl",
    )
)
EXACT_EVIDENCE = {"native_invocation", "instrumented_invocation"}
SKILL_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.:-]*$")


def project_skill_roots():
    """Use the current Git checkout, including linked worktrees, not its siblings."""
    cwd = Path.cwd().resolve()
    try:
        result = subprocess.run(
            ["git", "-C", str(cwd), "rev-parse", "--show-toplevel"],
            stdin=subprocess.DEVNULL, capture_output=True, text=True,
            timeout=5, check=False,
        )
        project = Path(result.stdout.strip()).resolve(strict=True) if result.returncode == 0 else cwd
    except (OSError, subprocess.TimeoutExpired):
        project = cwd
    if not cwd.is_relative_to(project):
        return []
    # Nested skill roots follow the working directory's ancestors up to this
    # checkout. A root symlink must not widen access outside the checkout.
    roots = []
    for directory in (cwd, *cwd.parents):
        if not directory.is_relative_to(project):
            break
        for client in (".agents", ".claude", ".codex"):
            candidate = directory / client / "skills"
            try:
                resolved = candidate.resolve(strict=True)
                if resolved.is_dir() and resolved.is_relative_to(project):
                    roots.append(resolved)
            except OSError:
                continue
    return roots


def skill_roots():
    """Return resolved skill roots; explicit overrides remain exclusive."""
    configured = os.environ.get("CC_SKILL_ROOTS")
    if configured:
        candidates = [Path(item) for item in configured.split(os.pathsep) if item]
    else:
        candidates = [
            Path.home() / ".claude" / "skills",
            Path.home() / ".codex" / "skills",
            Path.home() / ".agents" / "skills",
            Path.home() / ".config" / "ai-agents" / "current" / "skills",
            Path.home() / ".claude" / "plugins" / "cache",
            Path.home() / ".codex" / "plugins" / "cache",
            *project_skill_roots(),
        ]
    roots = []
    for candidate in candidates:
        try:
            resolved = candidate.resolve(strict=True)
            if resolved.is_dir() and resolved not in roots:
                roots.append(resolved)
        except OSError:
            continue
    return roots


def parse_declared_name(content):
    """Read only the top YAML frontmatter name without requiring PyYAML."""
    lines = content.splitlines()
    if not lines or lines[0].strip() != "---":
        return None
    for line in lines[1:]:
        if line.strip() == "---":
            break
        match = re.match(r"^name:\s*[\"']?([^\"'#]+?)[\"']?\s*$", line)
        if match:
            return match.group(1).strip()
    return None


def validated_skill(path, requested_name=None):
    if path.name != "SKILL.md":
        raise ValueError("target must be a SKILL.md file")
    resolved = path.resolve(strict=True)
    if not resolved.is_file():
        raise ValueError("target must be a regular file")
    if not any(resolved.is_relative_to(root) for root in skill_roots()):
        raise ValueError("target is outside allowed skill roots")
    content = resolved.read_text(encoding="utf-8")
    declared = parse_declared_name(content)
    if not declared or not SKILL_NAME.fullmatch(declared):
        raise ValueError("SKILL.md has no valid frontmatter name")
    if requested_name:
        if not SKILL_NAME.fullmatch(requested_name):
            raise ValueError("invalid requested skill name")
        if requested_name != declared and requested_name.rsplit(":", 1)[-1] != declared:
            raise ValueError("requested skill name does not match frontmatter")
    return resolved, declared, content


def append_event(event):
    EVENT_LOG.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    payload = (json.dumps(event, sort_keys=True, separators=(",", ":")) + "\n").encode()
    if len(payload) > 4096:
        raise ValueError("event exceeds append safety bound")
    fd = os.open(EVENT_LOG, os.O_APPEND | os.O_CREAT | os.O_WRONLY, 0o600)
    try:
        os.write(fd, payload)
    finally:
        os.close(fd)
    os.chmod(EVENT_LOG, 0o600)


def load_skill_command(args):
    """Print a skill unchanged and log only after a complete validated read."""
    resolved, declared, content = validated_skill(Path(args.path), args.skill)
    session_id = (
        args.session_id
        or os.environ.get("CODEX_THREAD_ID")
        or os.environ.get("CODEX_SESSION_ID")
        or "unknown"
    )
    event = {
        "schema": 1,
        "timestamp": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "host": "codex",
        "session_id": session_id,
        "skill": args.skill,
        "declared_name": declared,
        "evidence": "instrumented_invocation",
        "source_path_hash": "sha256:" + hashlib.sha256(str(resolved).encode()).hexdigest(),
        "project": Path.cwd().name,
        "subagent": bool(args.subagent),
    }
    append_event(event)
    sys.stdout.write(content)
    return 0


# --------------------------------------------------------------------------
# Parsing
# --------------------------------------------------------------------------

def project_from_record(record, jsonl_path):
    """Best project label: basename of the record cwd, else the encoded dir."""
    cwd = record.get("cwd")
    if cwd:
        base = os.path.basename(cwd.rstrip("/"))
        if base:
            return base
    # Fallback: the first directory segment under projects/ is the encoded cwd.
    try:
        rel = jsonl_path.relative_to(PROJECTS_DIR)
        return rel.parts[0]
    except ValueError:
        return jsonl_path.parent.name


def repo_hint_from_path(jsonl_path):
    """Encoded top-level project dir. Stable across worktrees of the same repo
    (e.g. every '.../MethodeAristote-app--worktrees-<branch>' session shares the
    'MethodeAristote-app' substring), unlike the cwd basename which is the
    worktree's branch-named leaf directory."""
    try:
        rel = jsonl_path.relative_to(PROJECTS_DIR)
        return rel.parts[0]
    except ValueError:
        return jsonl_path.parent.name


def is_subagent(jsonl_path):
    return "subagents" in jsonl_path.parts


def extract_text(message):
    """Best-effort plain text from a user/assistant message, for context display."""
    if not isinstance(message, dict):
        return None
    content = message.get("content")
    if isinstance(content, str):
        text = content
    elif isinstance(content, list):
        parts = [
            b.get("text", "") for b in content
            if isinstance(b, dict) and b.get("type") == "text"
        ]
        text = " ".join(p for p in parts if p)
    else:
        return None
    text = " ".join(text.split())
    return text[:200] if text else None


def parse_file(jsonl_path):
    """Yield one event dict per real Skill invocation found in a transcript."""
    subagent = is_subagent(jsonl_path)
    repo_hint = repo_hint_from_path(jsonl_path)
    last_user_text = None
    try:
        with jsonl_path.open("r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                has_skill = False
                is_user_line = '"type":"user"' in line or '"type": "user"' in line
                if is_user_line:
                    # A Skill tool_use only ever appears in an assistant record,
                    # never a user one, so has_skill is irrelevant here even if
                    # the line happens to contain that substring (e.g. a tool
                    # result dumping a file that quotes a Skill JSON example).
                    # Tool results are stored as role "user" too and can be
                    # megabytes long (a full file read, a command output), so
                    # skip json.loads on them outright instead of paying to
                    # deserialize a huge blob just to look for a short prompt.
                    if '"tool_result"' in line or len(line) > 20000:
                        continue
                else:
                    has_skill = '"name":"Skill"' in line or '"name": "Skill"' in line
                    if not has_skill:
                        continue
                try:
                    record = json.loads(line)
                except (ValueError, json.JSONDecodeError):
                    continue

                if record.get("type") == "user":
                    text = extract_text(record.get("message"))
                    if text:
                        last_user_text = text
                    continue

                if not has_skill:
                    continue
                message = record.get("message")
                if not isinstance(message, dict):
                    continue
                content = message.get("content")
                if not isinstance(content, list):
                    continue
                for block in content:
                    if not isinstance(block, dict):
                        continue
                    if block.get("type") != "tool_use" or block.get("name") != "Skill":
                        continue
                    inp = block.get("input") or {}
                    skill = inp.get("skill")
                    if not skill:
                        continue
                    yield {
                        "skill": skill,
                        "args": inp.get("args"),
                        "ts": record.get("timestamp"),
                        "host": "claude",
                        "evidence": "native_invocation",
                        "project": project_from_record(record, jsonl_path),
                        "repo_hint": repo_hint,
                        "session": jsonl_path.stem,
                        "subagent": subagent,
                        "context": last_user_text,
                    }
    except (OSError, IOError):
        return


def normalized_cwd(value):
    if not value:
        return None
    if value.startswith("file://"):
        parsed = urlparse(value)
        return Path(unquote(parsed.path))
    return Path(value)


def read_instrumented_events():
    """Read exact forward Codex events, skipping malformed or foreign lines."""
    events = []
    malformed = 0
    if not EVENT_LOG.exists():
        return events, malformed
    try:
        with EVENT_LOG.open("r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if not line.endswith("\n"):
                    malformed += 1
                    continue
                try:
                    record = json.loads(line)
                except (ValueError, json.JSONDecodeError):
                    malformed += 1
                    continue
                if (
                    not isinstance(record, dict)
                    or record.get("schema") != 1
                    or record.get("host") != "codex"
                    or record.get("evidence") != "instrumented_invocation"
                    or not SKILL_NAME.fullmatch(str(record.get("skill", "")))
                ):
                    malformed += 1
                    continue
                project = str(record.get("project") or "unknown")
                events.append({
                    "skill": record["skill"],
                    "args": None,
                    "ts": record.get("timestamp"),
                    "host": "codex",
                    "evidence": "instrumented_invocation",
                    "project": project,
                    "repo_hint": project,
                    "session": str(record.get("session_id") or "unknown"),
                    "subagent": bool(record.get("subagent")),
                    "context": None,
                })
    except OSError:
        malformed += 1
    return events, malformed


def observed_skill_name(path):
    try:
        _, declared, _ = validated_skill(path)
        return declared
    except (OSError, UnicodeError, ValueError):
        return path.parent.name if SKILL_NAME.fullmatch(path.parent.name) else None


def parse_codex_file(jsonl_path):
    """Yield inferred SKILL.md reads from completed Codex command items."""
    session_id = jsonl_path.stem
    session_subagent = False
    seen = set()
    try:
        with jsonl_path.open("r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if len(line) > 1000000:
                    continue
                if '"type":"session_meta"' in line or '"type": "session_meta"' in line:
                    try:
                        record = json.loads(line)
                    except (ValueError, json.JSONDecodeError):
                        continue
                    payload = record.get("payload") or {}
                    session_id = str(payload.get("id") or payload.get("session_id") or session_id)
                    source = json.dumps(payload.get("source") or payload.get("thread_source") or "")
                    session_subagent = "subagent" in source.lower() or "thread_spawn" in source.lower()
                    continue
                if "CommandExecution" not in line or "SKILL.md" not in line or "item_completed" not in line:
                    continue
                try:
                    record = json.loads(line)
                except (ValueError, json.JSONDecodeError):
                    continue
                payload = record.get("payload") or {}
                item = payload.get("item") or {}
                if (
                    payload.get("type") != "item_completed"
                    or item.get("type") != "CommandExecution"
                    or item.get("status") != "completed"
                    or item.get("exit_code") != 0
                ):
                    continue
                cwd = normalized_cwd(item.get("cwd"))
                if cwd is None:
                    continue
                for command in item.get("parsed_cmd") or []:
                    if not isinstance(command, dict) or command.get("type") != "read":
                        continue
                    raw_path = command.get("path")
                    if not raw_path or Path(raw_path).name != "SKILL.md":
                        continue
                    candidate = Path(raw_path)
                    if not candidate.is_absolute():
                        candidate = cwd / candidate
                    try:
                        resolved = candidate.resolve(strict=True)
                    except OSError:
                        continue
                    if not any(resolved.is_relative_to(root) for root in skill_roots()):
                        continue
                    key = (session_id, payload.get("turn_id"), str(resolved))
                    if key in seen:
                        continue
                    seen.add(key)
                    skill = observed_skill_name(resolved)
                    if not skill:
                        continue
                    project = cwd.name or "unknown"
                    yield {
                        "skill": skill,
                        "args": None,
                        "ts": record.get("timestamp"),
                        "host": "codex",
                        "evidence": "observed_load",
                        "project": project,
                        "repo_hint": str(cwd),
                        "session": session_id,
                        "subagent": session_subagent,
                        "context": None,
                    }
    except OSError:
        return


def collect_codex_observed():
    if not CODEX_SESSIONS_DIR.exists():
        return []
    events = []
    for path in CODEX_SESSIONS_DIR.rglob("*.jsonl"):
        events.extend(parse_codex_file(path))
    return events


# --------------------------------------------------------------------------
# Cache (mtime-invalidated)
# --------------------------------------------------------------------------

def load_cache():
    if not CACHE_FILE.exists():
        return {}
    try:
        with CACHE_FILE.open("r", encoding="utf-8") as fh:
            data = json.load(fh)
        if data.get("schema") != CACHE_SCHEMA:
            return {}
        return data.get("files", {})
    except (OSError, ValueError, json.JSONDecodeError):
        return {}


def save_cache(files):
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        tmp = CACHE_FILE.with_suffix(".tmp")
        with tmp.open("w", encoding="utf-8") as fh:
            json.dump({"schema": CACHE_SCHEMA, "files": files}, fh)
        tmp.replace(CACHE_FILE)
    except OSError:
        pass


def collect_claude_events(no_cache=False, rebuild=False):
    """Scan all transcripts, using the mtime cache to skip unchanged files."""
    if not PROJECTS_DIR.exists():
        sys.stderr.write(f"No transcripts directory at {PROJECTS_DIR}\n")
        return []

    cache = {} if (no_cache or rebuild) else load_cache()
    new_cache = {}
    events = []

    for path in PROJECTS_DIR.rglob("*.jsonl"):
        key = str(path)
        try:
            mtime = path.stat().st_mtime
        except OSError:
            continue
        entry = cache.get(key)
        if entry and entry.get("mtime") == mtime:
            file_events = entry["events"]
        else:
            file_events = list(parse_file(path))
        new_cache[key] = {"mtime": mtime, "events": file_events}
        events.extend(file_events)

    if not no_cache:
        save_cache(new_cache)
    return events


def collect_events(host="all", include_inferred_codex=False, no_cache=False, rebuild=False):
    events = []
    diagnostics = {"malformed_event_lines": 0}
    if host in {"claude", "all"}:
        events.extend(collect_claude_events(no_cache=no_cache, rebuild=rebuild))
    if host in {"codex", "all"}:
        instrumented, malformed = read_instrumented_events()
        events.extend(instrumented)
        diagnostics["malformed_event_lines"] = malformed
        if include_inferred_codex:
            events.extend(collect_codex_observed())
    return events, diagnostics


# --------------------------------------------------------------------------
# Filtering & helpers
# --------------------------------------------------------------------------

def parse_ts(ts):
    if not ts:
        return None
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except ValueError:
        return None


def parse_since(since):
    """Accept 7d / 24h / 2w or an ISO date YYYY-MM-DD. Returns aware datetime."""
    now = datetime.now(timezone.utc)
    s = since.strip().lower()
    units = {"h": "hours", "d": "days", "w": "weeks"}
    if s and s[-1] in units and s[:-1].isdigit():
        return now - timedelta(**{units[s[-1]]: int(s[:-1])})
    try:
        d = datetime.fromisoformat(s)
        if d.tzinfo is None:
            d = d.replace(tzinfo=timezone.utc)
        return d
    except ValueError:
        sys.stderr.write(f"Bad --since value: {since} (use 7d, 24h, 2w or a date)\n")
        sys.exit(2)


def apply_filters(events, args):
    out = events
    if not args.include_subagents:
        out = [e for e in out if not e["subagent"]]
    if args.project:
        needle = args.project.lower()
        out = [
            e for e in out
            if needle in e["project"].lower() or needle in e["repo_hint"].lower()
        ]
    if args.since:
        floor = parse_since(args.since)
        kept = []
        for e in out:
            dt = parse_ts(e["ts"])
            if dt is not None and dt >= floor:
                kept.append(e)
        out = kept
    return out


def fmt_day(ts):
    dt = parse_ts(ts)
    return dt.date().isoformat() if dt else "unknown"


# --------------------------------------------------------------------------
# Views
# --------------------------------------------------------------------------

def view_leaderboard(events, as_json, show_context=False):
    counts = Counter((e["host"], e["skill"], e["evidence"]) for e in events)
    projects = defaultdict(set)
    first = {}
    last = {}
    most_recent = {}  # skill -> (dt, event), for the last-context column

    for e in events:
        key = (e["host"], e["skill"], e["evidence"])
        projects[key].add(e["project"])
        day = fmt_day(e["ts"])
        if day != "unknown":
            if key not in first or day < first[key]:
                first[key] = day
            if key not in last or day > last[key]:
                last[key] = day
        dt = parse_ts(e["ts"])
        if dt is not None:
            prev = most_recent.get(key)
            if prev is None or dt > prev[0]:
                most_recent[key] = (dt, e)

    rows = []
    for (host, skill, evidence), n in counts.most_common():
        key = (host, skill, evidence)
        row = {
            "host": host,
            "skill": skill,
            "evidence": evidence,
            "events": n,
            "invocations": n if evidence in EXACT_EVIDENCE else 0,
            "observed_loads": n if evidence == "observed_load" else 0,
            "projects": len(projects[key]),
            "first_seen": first.get(key, "unknown"),
            "last_seen": last.get(key, "unknown"),
        }
        if show_context:
            recent = most_recent.get(key)
            if recent:
                _, e = recent
                row["last_context"] = e["context"]
                row["last_context_project"] = e["project"]
                row["last_context_session"] = e["session"]
            else:
                row["last_context"] = None
                row["last_context_project"] = None
                row["last_context_session"] = None
        rows.append(row)

    if as_json:
        print(json.dumps({
            "total_invocations": sum(
                n for (_, _, evidence), n in counts.items() if evidence in EXACT_EVIDENCE
            ),
            "total_observed_loads": sum(
                n for (_, _, evidence), n in counts.items() if evidence == "observed_load"
            ),
            "distinct_skills": len({e["skill"] for e in events}),
            "skills": rows,
        }, indent=2))
        return

    if not rows:
        print("No skill usage evidence found.")
        return

    wname = max(len("SKILL"), max(len(r["skill"]) for r in rows))

    if not show_context:
        print(f"{'HOST':<6}  {'SKILL':<{wname}}  {'EVIDENCE':<23}  {'EVENTS':>6}  {'PROJ':>4}  {'FIRST':>10}  {'LAST':>10}")
        print(f"{'-'*6}  {'-' * wname}  {'-'*23}  {'-'*6}  {'-'*4}  {'-'*10}  {'-'*10}")
        for r in rows:
            print(f"{r['host']:<6}  {r['skill']:<{wname}}  {r['evidence']:<23}  {r['events']:>6}  {r['projects']:>4}  "
                  f"{r['first_seen']:>10}  {r['last_seen']:>10}")
    else:
        # Cramming skill / counts / project / a free-text context into one
        # fixed-width row breaks down: the context length varies wildly and
        # either truncates mid-word or wraps unpredictably depending on the
        # terminal. A block per skill (stat line, then an indented context
        # line) survives any terminal width and any context length instead.
        width = shutil.get_terminal_size(fallback=(100, 24)).columns
        ctx_width = max(40, width - 4)
        for r in rows:
            plural = "s" if r["events"] != 1 else ""
            header = (
                f"{r['host']}:{r['skill']}  ({r['events']} {r['evidence']} event{plural}, "
                f"{r['projects']} project{'s' if r['projects'] != 1 else ''}, "
                f"last {r['last_seen']}"
            )
            if r["last_context_project"]:
                header += f", in {r['last_context_project']}"
            header += ")"
            print(header)
            ctx = r["last_context"] or "(no preceding user message found)"
            if len(ctx) > ctx_width:
                ctx = ctx[:ctx_width - 3] + "..."
            print(f"  -> {ctx}")

    exact = sum(n for (_, _, evidence), n in counts.items() if evidence in EXACT_EVIDENCE)
    inferred = sum(n for (_, _, evidence), n in counts.items() if evidence == "observed_load")
    print(f"\n{exact} exact invocations, {inferred} inferred loads across "
          f"{len({e['skill'] for e in events})} skills.")


def view_detail(events, skill, as_json, show_context=False):
    hits = [e for e in events if e["skill"] == skill]
    by_project = Counter(e["project"] for e in hits)
    by_day = Counter(fmt_day(e["ts"]) for e in hits)
    by_args = Counter(e["args"] for e in hits if e["args"])
    sessions = {e["session"] for e in hits}
    by_host = Counter(e["host"] for e in hits)
    by_evidence = Counter(e["evidence"] for e in hits)
    exact = sum(n for evidence, n in by_evidence.items() if evidence in EXACT_EVIDENCE)

    if as_json:
        print(json.dumps({
            "skill": skill,
            "invocations": exact,
            "observed_loads": by_evidence.get("observed_load", 0),
            "sessions": len(sessions),
            "by_host": dict(by_host.most_common()),
            "by_evidence": dict(by_evidence.most_common()),
            "by_project": dict(by_project.most_common()),
            "by_day": dict(sorted(by_day.items())),
            "by_args": dict(by_args.most_common()),
            "recent": [
                {
                    "ts": e["ts"], "host": e["host"], "evidence": e["evidence"],
                    "project": e["project"], "session": e["session"],
                    "args": e["args"], "context": e["context"],
                }
                for e in sorted(
                    (e for e in hits if parse_ts(e["ts"]) is not None),
                    key=lambda e: parse_ts(e["ts"]), reverse=True,
                )[:20]
            ],
        }, indent=2))
        return

    if not hits:
        print(f"No usage evidence for '{skill}'.")
        return

    print(f"{skill}: {exact} exact invocations, "
          f"{by_evidence.get('observed_load', 0)} inferred loads across {len(sessions)} sessions\n")
    print("By evidence:")
    for evidence, n in by_evidence.most_common():
        print(f"  {n:>4}  {evidence}")
    print("\nBy host:")
    for host, n in by_host.most_common():
        print(f"  {n:>4}  {host}")
    print("\nBy project:")
    for proj, n in by_project.most_common():
        print(f"  {n:>4}  {proj}")
    if by_args:
        print("\nBy argument:")
        for a, n in by_args.most_common():
            print(f"  {n:>4}  {a}")
    print("\nBy day:")
    for day, n in sorted(by_day.items()):
        bar = "#" * min(n, 40)
        print(f"  {day}  {n:>3}  {bar}")

    if show_context:
        dated = sorted(
            (e for e in hits if parse_ts(e["ts"]) is not None),
            key=lambda e: parse_ts(e["ts"]), reverse=True,
        )
        print(f"\nRecent invocations (context = last user message before the call):")
        for e in dated[:10]:
            dt = parse_ts(e["ts"])
            when = dt.strftime("%Y-%m-%d %H:%M")
            sid = e["session"][:8]
            ctx = e["context"] or "(no preceding user message found)"
            print(f"  {when}  {e['host']}  {e['evidence']}  {e['project']}  session {sid}")
            print(f"    -> {ctx}")


def view_recent(events, limit, as_json, show_context=False):
    dated = [(parse_ts(e["ts"]), e) for e in events]
    dated = [(dt, e) for dt, e in dated if dt is not None]
    dated.sort(key=lambda x: x[0], reverse=True)
    picked = [e for _, e in dated[:limit]]

    if as_json:
        print(json.dumps([{
            "ts": e["ts"], "skill": e["skill"], "args": e["args"],
            "host": e["host"], "evidence": e["evidence"],
            "project": e["project"], "session": e["session"],
            "subagent": e["subagent"], "context": e["context"],
        } for e in picked], indent=2))
        return

    if not picked:
        print("No invocations found.")
        return

    wname = max(len(e["skill"]) for e in picked)
    for e in picked:
        dt = parse_ts(e["ts"])
        when = dt.strftime("%Y-%m-%d %H:%M") if dt else "unknown"
        tag = " (subagent)" if e["subagent"] else ""
        arg = f" [{e['args']}]" if e["args"] else ""
        sid = e["session"][:8]
        print(f"{when}  {e['host']:<6}  {e['evidence']:<23}  "
              f"{e['skill']:<{wname}}{arg}  {e['project']}{tag}  session {sid}")
        if show_context:
            ctx = e["context"] or "(no preceding user message found)"
            print(f"  -> {ctx}")


