def build_parser():
    p = argparse.ArgumentParser(
        prog="cc-skill-usage",
        description="Cross-client Skill usage analytics with explicit evidence classes.",
    )
    p.add_argument("skill", nargs="?", help="show detail for one skill")
    p.add_argument("--all", nargs=2, metavar=("MODE", "N"),
                   help="e.g. --all recent 20 : list the N most recent invocations")
    p.add_argument("--since", metavar="WINDOW",
                   help="time filter: 7d, 24h, 2w, or a date YYYY-MM-DD")
    p.add_argument("--project", metavar="NAME",
                   help="filter by project: substring match on the cwd basename "
                        "OR the encoded project directory, so one repo's worktrees "
                        "(different branch-named cwd) match a single needle, e.g. "
                        "--project aristote")
    p.add_argument("--include-subagents", action="store_true",
                   help="also count invocations made inside subagents")
    p.add_argument("--host", choices=("claude", "codex", "all"), default="all",
                   help="limit evidence to one host (default: all)")
    p.add_argument("--include-inferred-codex", action="store_true",
                   help="include observed Codex SKILL.md reads as inferred evidence")
    p.add_argument("--show-context", action="store_true",
                   help="show the user message that preceded each invocation: "
                        "an indented context line under each skill on the "
                        "leaderboard (most recent per skill), a full "
                        "recent-invocations section in detail view, and "
                        "inline in --all recent")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.add_argument("--no-cache", action="store_true",
                   help="parse everything fresh, ignore and do not write the cache")
    p.add_argument("--rebuild", action="store_true",
                   help="ignore the cache on read but rewrite it")
    p.add_argument("--version", action="version", version=f"cc-skill-usage {VERSION}")
    return p


def build_load_parser():
    p = argparse.ArgumentParser(
        prog="cc-skill-usage load",
        description="Validate and print one Codex skill, then append exact local evidence.",
    )
    p.add_argument("--skill", required=True, help="runtime skill name")
    p.add_argument("--path", required=True, help="absolute path to SKILL.md")
    p.add_argument("--session-id", help="Codex thread/session identifier")
    p.add_argument("--subagent", action="store_true", help="mark invocation as subagent-owned")
    return p


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == "load":
        try:
            return load_skill_command(build_load_parser().parse_args(argv[1:]))
        except (OSError, UnicodeError, ValueError) as error:
            sys.stderr.write(f"load failed: {error}\n")
            return 2

    args = build_parser().parse_args(argv)

    t0 = time.time()
    events, diagnostics = collect_events(
        host=args.host,
        include_inferred_codex=args.include_inferred_codex,
        no_cache=args.no_cache,
        rebuild=args.rebuild,
    )
    events = apply_filters(events, args)
    elapsed = time.time() - t0

    if args.all:
        mode, n = args.all
        if mode != "recent":
            sys.stderr.write("Only '--all recent N' is supported.\n")
            return 2
        try:
            limit = int(n)
        except ValueError:
            sys.stderr.write(f"N must be an integer, got {n!r}.\n")
            return 2
        view_recent(events, limit, args.json, show_context=args.show_context)
    elif args.skill:
        view_detail(events, args.skill, args.json, show_context=args.show_context)
    else:
        view_leaderboard(events, args.json, show_context=args.show_context)

    if not args.json and os.environ.get("CC_SKILL_USAGE_TIMING"):
        sys.stderr.write(f"\nscanned in {elapsed:.2f}s\n")
    if diagnostics["malformed_event_lines"]:
        sys.stderr.write(
            f"Skipped {diagnostics['malformed_event_lines']} malformed event-log line(s).\n"
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
